---
import { postUrl, seriesUrl, type Post } from '../lib/posts';

export interface Props {
  series: string;
  posts: Post[];
  currentId: string;
}

const { series, posts, currentId } = Astro.props;
const index = posts.findIndex((p) => p.id === currentId);
---

<details class="series" open={posts.length <= 10} data-pagefind-ignore>
  <summary>
    <a href={seriesUrl(series)}>{series}</a>
    <span class="muted">{index + 1} / {posts.length}</span>
  </summary>
  <ol>
    {
      posts.map((post) => (
        <li aria-current={post.id === currentId ? 'page' : undefined}>
          <a href={postUrl(post)}>{post.data.title}</a>
        </li>
      ))
    }
  </ol>
</details>

<style>
  .series {
    margin: 0 0 32px;
    padding: 16px 20px;
    border-radius: 14px;
    background: var(--bg-soft);
    font-size: 0.9375rem;
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    font-weight: 700;
  }
  summary a:hover {
    color: var(--accent);
  }
  summary span {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  ol {
    margin: 12px 0 0;
    padding-left: 1.4em;
    color: var(--text-muted);
  }
  li {
    padding: 2px 0;
  }
  li a:hover {
    color: var(--accent);
  }
  li[aria-current='page'] {
    color: var(--accent);
    font-weight: 700;
  }
</style>

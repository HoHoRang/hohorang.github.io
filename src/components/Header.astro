---
import { SITE } from '../consts';
import NewMark from './NewMark.astro';
import { getPosts, categoryCounts, categoryUrl } from '../lib/posts';

const posts = await getPosts();
const tree = categoryCounts(posts);
const nav = [
  { href: '/categories/', label: 'Category' },
  { href: '/tags/', label: 'Tags' },
  { href: '/series/', label: 'Series' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="inner">
    <button class="icon-btn" type="button" aria-label="카테고리 열기" data-drawer-open>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
    <a class="logo" href="/">{SITE.title}</a>
    <nav class="nav" aria-label="주요 메뉴">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="icon-btn" href="/search/" aria-label="검색">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    </a>
    <button class="icon-btn" type="button" aria-label="다크 모드 전환" data-theme-toggle>
      <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    </button>
  </div>
</header>

<dialog class="drawer" data-drawer aria-label="카테고리">
  <div class="drawer-head">
    <strong>Category</strong>
    <button class="icon-btn" type="button" aria-label="닫기" data-drawer-close>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </div>
  <a class="drawer-all" href="/">전체 글 <span class="count">{posts.length}</span></a>
  <ul class="tree">
    {
      tree.map(({ category, count, latest, children }) => (
        <li>
          <a class="top" href={categoryUrl(category)}>
            {category.emoji} {category.name} <NewMark variant="dot" date={latest} />
            <span class="count">{count}</span>
          </a>
          {children.length > 0 && (
            <ul>
              {children.map((child) => (
                <li>
                  <a href={categoryUrl(child.category)}>
                    {child.category.name} <NewMark variant="dot" date={child.latest} />
                    <span class="count">{child.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
  <nav class="drawer-nav" aria-label="모바일 메뉴">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</dialog>

<script>
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]')!;
  document.querySelector('[data-drawer-open]')?.addEventListener('click', () => drawer.showModal());
  document.querySelector('[data-drawer-close]')?.addEventListener('click', () => drawer.close());
  // 바깥(backdrop) 클릭 시 닫기
  drawer.addEventListener('click', (e) => {
    if (e.target === drawer) drawer.close();
  });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-height);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 8px;
  }
  .logo {
    font-weight: 800;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    margin-right: auto;
    padding: 0 8px;
    white-space: nowrap;
  }
  .nav {
    display: flex;
    gap: 4px;
  }
  .nav a {
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--text);
    background: var(--bg-soft);
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--text);
    background: var(--bg-soft);
  }
  :global(:root[data-theme='dark']) .sun,
  :global(:root:not([data-theme='dark'])) .moon {
    display: none;
  }
  @media (max-width: 640px) {
    .nav {
      display: none;
    }
  }

  .drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(320px, 85vw);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 24px;
    border: 0;
    border-right: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    overflow-y: auto;
  }
  .drawer::backdrop {
    background: rgb(0 0 0 / 0.35);
  }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    padding: 0 8px 0 20px;
    border-bottom: 1px solid var(--border);
  }
  .drawer a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 20px;
    border-radius: 0;
  }
  .drawer a:hover {
    background: var(--bg-soft);
    color: var(--accent);
  }
  .drawer-all {
    margin-top: 12px;
    font-weight: 700;
  }
  .count {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .tree,
  .tree ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tree .top {
    margin-top: 8px;
    font-weight: 600;
  }
  .tree ul a {
    padding-left: 40px;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .drawer-nav {
    display: none;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  @media (max-width: 640px) {
    .drawer-nav {
      display: block;
    }
  }
</style>

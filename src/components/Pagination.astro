---
export interface Props {
  current: number;
  total: number;
  // 페이지 번호로 URL을 만드는 함수 (1페이지는 보통 목록의 루트)
  href: (page: number) => string;
}

const { current, total, href } = Astro.props;
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="페이지">
      {current > 1 ? <a href={href(current - 1)} rel="prev">이전</a> : <span class="disabled">이전</span>}
      {pages.map((page) =>
        page === current ? (
          <span class="current" aria-current="page">{page}</span>
        ) : (
          <a href={href(page)}>{page}</a>
        ),
      )}
      {current < total ? <a href={href(current + 1)} rel="next">다음</a> : <span class="disabled">다음</span>}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    margin-top: 40px;
    font-size: 0.9375rem;
  }
  a,
  span {
    min-width: 36px;
    padding: 6px 10px;
    border-radius: 8px;
    text-align: center;
  }
  a:hover {
    background: var(--bg-soft);
    color: var(--accent);
  }
  .current {
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
  }
  .disabled {
    color: var(--text-muted);
    opacity: 0.5;
  }
</style>

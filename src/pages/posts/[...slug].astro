---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/TOC.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import AdSlot from '../../components/AdSlot.astro';
import Giscus from '../../components/Giscus.astro';
import { getCategory } from '../../data/categories';
import {
  categoryUrl,
  collectSeries,
  formatDate,
  getPosts,
  postUrl,
  readingMinutes,
  tagUrl,
} from '../../lib/posts';
import '../../styles/prose.css';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts는 최신순이므로 다음 글(newer)은 i-1, 이전 글(older)은 i+1
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, series, heroImage } = post.data;
const category = getCategory(post.data.category);
const parent = category.parent ? getCategory(category.parent) : undefined;
const seriesPosts = series
  ? collectSeries(await getPosts()).find((s) => s.series === series)?.posts
  : undefined;
const ogImage = heroImage ? (await getImage({ src: heroImage, width: 1200 })).src : undefined;
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  article={{ pubDate, updatedDate, category: post.data.category, tags }}
>
  <div class="layout">
    <article class="article" data-pagefind-body>
      <header class="post-header">
        <nav class="breadcrumb" aria-label="카테고리 경로">
          {parent && <a href={categoryUrl(parent)}>{parent.name}</a>}
          {parent && <span aria-hidden="true">›</span>}
          <a href={categoryUrl(category)}>{category.name}</a>
        </nav>
        <h1>{title}</h1>
        <div class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {
            updatedDate && formatDate(updatedDate) !== formatDate(pubDate) && (
              <span>
                · 수정 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            )
          }
          <span>· {readingMinutes(post.body)}분 분량</span>
        </div>
      </header>

      {series && seriesPosts && <SeriesNav series={series} posts={seriesPosts} currentId={post.id} />}

      <details class="toc-mobile" data-pagefind-ignore>
        <summary>목차</summary>
        <TOC headings={headings} />
      </details>

      <AdSlot slot="postTop" />

      <div class="prose">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <a class="chip" href={tagUrl(tag)}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      <AdSlot slot="postBottom" />

      <nav class="adjacent" aria-label="이전/다음 글" data-pagefind-ignore>
        {
          older ? (
            <a href={postUrl(older)} rel="prev">
              <span class="muted">이전 글</span>
              {older.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a class="next" href={postUrl(newer)} rel="next">
              <span class="muted">다음 글</span>
              {newer.data.title}
            </a>
          )
        }
      </nav>

      <Giscus />
    </article>

    <aside class="toc-side">
      <TOC headings={headings} />
    </aside>
  </div>
</BaseLayout>

<script>
  // 코드 블록 복사 버튼, 넓은 표 가로 스크롤
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = '복사';
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
      btn.textContent = '복사됨';
      setTimeout(() => (btn.textContent = '복사'), 1500);
    });
    pre.appendChild(btn);
  });
  document.querySelectorAll('.prose table').forEach((table) => {
    const wrap = document.createElement('div');
    wrap.className = 'table-wrap';
    table.replaceWith(wrap);
    wrap.appendChild(table);
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--content-width));
    justify-content: center;
    gap: 48px;
    padding: 0 16px;
  }
  .toc-side {
    display: none;
  }
  @media (min-width: 1200px) {
    .layout {
      grid-template-columns: minmax(0, var(--content-width)) 240px;
    }
    .toc-side {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + 40px);
      align-self: start;
      max-height: calc(100vh - var(--header-height) - 80px);
      overflow-y: auto;
      margin-top: 48px;
    }
    .toc-mobile {
      display: none;
    }
  }

  .post-header {
    margin: 48px 0 32px;
  }
  .breadcrumb {
    display: flex;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  h1 {
    margin: 8px 0 12px;
    font-size: clamp(1.625rem, 4vw, 2.125rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .toc-mobile {
    margin: 0 0 24px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .toc-mobile:not(:has(nav)) {
    display: none;
  }
  .toc-mobile summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .toc-mobile :global(.toc-title) {
    display: none;
  }
  .toc-mobile :global(.toc) {
    margin-top: 12px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 48px;
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 48px;
  }
  .adjacent a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.5;
    transition: border-color 0.15s;
  }
  .adjacent a:hover {
    border-color: var(--accent);
  }
  .adjacent .next {
    grid-column: 2;
    text-align: right;
  }
  .adjacent span {
    font-size: 0.8125rem;
    font-weight: 500;
  }
  @media (max-width: 640px) {
    .adjacent {
      grid-template-columns: 1fr;
    }
    .adjacent .next {
      grid-column: 1;
    }
  }
</style>
